{
  "name": "homoludens",
  "compatibility_date": "2025-09-01",
  // worker.js serves /api/feedback; everything else comes straight from ./public
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // at most 3 feedback messages per visitor per minute
  "ratelimits": [
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ]
}
